# Provedor de IA a usar: "ollama", "openrouter" ou "gateway"
# NOTA: Se configurar mais de um provedor, eles ficam disponíveis para alternar na interface (admin).
ROSITA_AI_PROVIDER=ollama

# Porta pública da interface web
ROSITA_WEB_PORT=18080

# Porta pública da API
ROSITA_API_PORT=18500

# ========== OLLAMA ==========
# Endereço do servidor de IA/Ollama.
# Padrão: usa o Ollama interno do docker-compose.
# Se preferir um servidor externo/manual, troque a linha abaixo.
# Exemplo externo: ROSITA_OLLAMA_HOST=https://seu-servidor-ia.exemplo.com
ROSITA_OLLAMA_HOST=http://localhost:11434

# Modelo sugerido para seleção manual no frontend
ROSITA_OLLAMA_MODEL=llama3.2:3b

# ========== OPEN ROUTER ==========
# Chave de API do Open Router (obtenha em https://openrouter.ai/keys)
# Necessária se ROSITA_AI_PROVIDER=openrouter
# Exemplo: sk-or-v1-abc123def456...
ROSITA_OPENROUTER_API_KEY=

# Modelo do Open Router a usar
# Exemplos: gpt-4-turbo, gpt-3.5-turbo, claude-3-opus, claude-3-sonnet, mistral-7b
# Lista completa: https://openrouter.ai/models
ROSITA_OPENROUTER_MODEL=

# ========== GATEWAY (IA LOCAL / OPENAI-COMPATIBLE) ==========
# Use quando você tem uma IA rodando no seu servidor local (vLLM, LocalAI, LM Studio, etc.)
# Deve expor endpoints OpenAI-compatible:
# - GET  /v1/models
# - POST /v1/chat/completions
#
# Exemplos:
# ROSITA_GATEWAY_URL=http://127.0.0.1:8000
# ROSITA_GATEWAY_URL=http://localhost:1234
# ROSITA_GATEWAY_URL=http://seu-servidor:8000
#
# Modelo sugerido para seleção manual no frontend (pode deixar vazio e selecionar via UI)
# ROSITA_GATEWAY_MODEL=seu-modelo

# ========== SEGURANÇA / AUTENTICAÇÃO ==========
# Chave usada para assinar as sessões. OBRIGATÓRIA em produção.
# Se ficar em branco, o sistema gera uma chave aleatória a cada início
# (as sessões não persistem entre reinícios). Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
ROSITA_SECRET_KEY=

# Nomes de usuário dos dois perfis (opcional; padrão admin/usuario)
ROSITA_ADMIN_USERNAME=admin
ROSITA_USER_USERNAME=usuario

# Senhas — use SEMPRE o hash (não a senha em texto) em produção.
# Gere o hash com:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('SUA_SENHA'))"
# Se os _HASH ficarem em branco, o sistema aceita a senha em texto via
# ROSITA_ADMIN_PASSWORD / ROSITA_USER_PASSWORD (menos seguro) e, na ausência
# de ambos, usa uma senha padrão de desenvolvimento (NÃO usar em produção).
ROSITA_ADMIN_PASSWORD_HASH=
ROSITA_USER_PASSWORD_HASH=

# Marque como true quando servir por HTTPS (cookies de sessão só por TLS)
ROSITA_SESSION_COOKIE_SECURE=false

# ========== AJUSTES OPCIONAIS ==========
ROSITA_MAX_HISTORY=5
ROSITA_MAX_INPUT_CHARS=1000
ROSITA_NUM_PREDICT=128
ROSITA_TEMPERATURE=0.7
ROSITA_TOP_P=0.9
ROSITA_REPEAT_PENALTY=1.1
ROSITA_DEBUG=false
