# Padrões do container (docker compose). Carregado ANTES de .env, backend/.env e
# backend/env.admin — qualquer um deles sobrepõe o que está aqui.
#
# Não coloque segredos neste arquivo: ele é versionado. Chaves de API e hashes
# vão no .env (não versionado) ou são salvos pelo painel admin em backend/.env.
#
# Valores com "$" exigem aspas SIMPLES (o Compose expande "$VAR" em valores sem
# aspas ou com aspas duplas, inclusive dentro de env_file).

# Provedor padrão: Open Router (nuvem). Alternativa: gateway local OpenAI-compatible.
ROSITA_AI_PROVIDER=openrouter
ROSITA_OPENROUTER_MODEL=

# Gateway local (opcional): fica disponível para alternar na interface (admin).
# Dentro do container, "localhost" não é o host — use host.docker.internal
# (mapeado para o gateway do host via extra_hosts no docker-compose.yml).
ROSITA_GATEWAY_URL=http://100.75.86.69:3001
ROSITA_GATEWAY_MODEL=deepseek-chat
